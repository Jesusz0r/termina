{
  "name": "pi-editor",
  "version": "0.1.0",
  "description": "Hybrid terminal/editor: prompt a pi coding agent in a terminal, watch it edit files live in a Monaco (VS Code) editor, click modified files to inspect them.",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e-test.mjs"
  },
  "dependencies": {
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "monaco-editor": "^0.56.0"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
