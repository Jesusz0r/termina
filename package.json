{
  "name": "termina",
  "productName": "Termina",
  "version": "0.1.26",
  "description": "Hybrid terminal/editor: prompt a pi coding agent in a terminal, watch it edit files live in a Monaco (VS Code) editor, click modified files to inspect them.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jesusz0r/termina.git"
  },
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "build": "node --experimental-strip-types scripts/build.ts && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:test-infra": "vitest run tests/unit/build/test-infra.test.ts",
    "report:agent-core": "node --experimental-strip-types tests/unit/agent-core/trace-report.ts",
    "test:agent-core": "vitest run tests/unit/agent-core/harness-kernel.test.ts",
    "test:agent-core-focused": "vitest run tests/unit/agent-core/",
    "test:agent-core-main": "vitest run tests/unit/agent-core/main-*.test.ts",
    "test:agent-core-session": "vitest run tests/unit/agent-core/session-segmented.test.ts tests/unit/agent-core/session-retention-admission.test.ts tests/unit/agent-core/session-receipt.test.ts",
    "test:agent-core-trace": "vitest run tests/unit/agent-core/trace-*.test.ts",
    "test:agent-core-measurement": "vitest run tests/unit/agent-core/cache-experiment.test.ts tests/unit/agent-core/token-calibration.test.ts tests/unit/agent-core/provider-probe.test.ts tests/unit/agent-core/provider-cache-policy.test.ts tests/unit/agent-core/rates.test.ts",
    "test:terminal-drop": "vitest run tests/unit/electron/terminal-drop.test.ts",
    "test:sandbox-security": "vitest run tests/unit/electron/sandbox-security.test.ts",
    "test:sandbox-security-live": "node --experimental-strip-types scripts/sandbox-security-live-gate.ts",
    "test:sandbox-security-gate": "vitest run tests/unit/electron/sandbox-gate.test.ts",
    "test:core-client": "vitest run tests/unit/electron/core-client.test.ts",
    "test:sidecar": "vitest run tests/unit/electron/sidecar.test.ts",
    "test:sidecar-races": "vitest run tests/unit/electron/sidecar-races.test.ts",
    "test:worldline-reopen-flow": "vitest run tests/unit/electron/worldlines-unit.test.ts",
    "test:worldline-runtime-flow": "vitest run tests/unit/electron/worldline-runtime-flow.test.ts",
    "test:watcher-and-pty": "vitest run tests/unit/electron/watcher.test.ts tests/unit/electron/pty-egress.test.ts",
    "test:ipc-project-flow": "vitest run tests/unit/electron/ipc-project-flow.test.ts",
    "test:ipc-navigation": "playwright test tests/e2e/ipc-navigation.spec.ts",
    "test:core-client-read-budget": "vitest run tests/unit/electron/core-client-read-budget.test.ts",
    "test:session-fork-worker": "vitest run tests/unit/electron/session-fork-worker.test.ts",
    "test:session-retention": "vitest run tests/unit/electron/session-fork-retention.test.ts tests/unit/electron/session-pi-admission.test.ts tests/unit/electron/session-retention-performance.test.ts",
    "test:session-fork-migration": "vitest run tests/unit/electron/session-fork-migration.test.ts",
    "test:e2e-release-smoke": "node --experimental-strip-types scripts/e2e-release-smoke.ts",
    "test:release-core": "vitest run tests/unit/build/release-core.test.ts",
    "test:dompurify-security": "vitest run tests/unit/security/dompurify.test.ts",
    "test:prepare-resources": "vitest run tests/unit/build/prepare-resources.test.ts",
    "test:worldline-project-ownership": "vitest run tests/unit/ui/worldline-project-ownership.test.ts",
    "test:worldline-recovery": "playwright test tests/e2e/worldlines.spec.ts",
    "test:release-workflow": "vitest run tests/unit/build/release-workflow.test.ts",
    "test:promotion-native-boundary": "npm run spike -- promotion-native-boundary",
    "test:release-macos": "npm run test:sandbox-security-live && npm run test:e2e-release-smoke",
    "test:release": "npm run test && npm run test:release-core && npm run test:agent-core-main && npm run test:release-workflow",
    "test": "npm run typecheck && npm run test:unit",
    "test:spikes": "npm run spike -- capture && npm run spike -- merge && npm run spike -- session-fork && npm run spike -- platform && npm run spike -- tree-delta && npm run spike -- gitignore && npm run spike -- terminal-roster && npm run spike -- core-session-promotion && npm run spike -- promotion-transaction && npm run spike -- watcher-idle && npm run test:promotion-native-boundary",
    "test:e2e": "playwright test",
    "test:e2e:watch": "playwright test --ui",
    "spike": "node --experimental-strip-types scripts/spike.ts",
    "dist": "npm run build && node --experimental-strip-types scripts/prepare-resources.ts && electron-builder",
    "dist:dir": "npm run build && node --experimental-strip-types scripts/prepare-resources.ts && electron-builder --dir",
    "dist:mac": "npm run build && node --experimental-strip-types scripts/prepare-resources.ts && electron-builder --mac"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@lydell/node-pty": "^1.2.0-beta.14",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "3.4.14",
    "electron-updater": "^6.8.9",
    "monaco-editor": "^0.56.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "dompurify": "3.4.14"
  }
}
