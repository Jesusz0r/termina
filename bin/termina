#!/usr/bin/env bash
# CLI launcher for Termina.
# Opens the given directory or file in Termina, defaulting to opening the app.
set -eu

# Best-effort canonical path for identity comparison: resolve symlinks
# (bounded) and normalize the directory physically. Never fails; used only
# to compare two paths, not for access decisions.
canonical_path() {
  local p="$1" n=0 link dir base
  while [ -L "$p" ] && [ "$n" -lt 40 ]; do
    link="$(readlink "$p" 2>/dev/null || true)"
    [ -n "$link" ] || break
    case "$link" in
      /*) p="$link" ;;
      *) p="$(dirname "$p")/$link" ;;
    esac
    n=$((n + 1))
  done
  if [ -d "$p" ]; then
    (cd "$p" 2>/dev/null && pwd -P) || echo "$p"
  else
    dir="$(dirname "$p")"
    base="$(basename "$p")"
    dir="$(cd "$dir" 2>/dev/null && pwd -P)" || { echo "$p"; return 0; }
    echo "$dir/$base"
  fi
  return 0
}

# Normalize one CLI path argument to an absolute path. Shared by the macOS
# and Linux launch branches.
resolve_target_path() {
  local target="$1" dir
  if [ -d "$target" ]; then
    (cd "$target" 2>/dev/null && pwd)
  elif [ -f "$target" ]; then
    dir="$(cd "$(dirname "$target")" 2>/dev/null && pwd)"
    echo "$dir/$(basename "$target")"
  else
    echo "$(pwd)/$target"
  fi
}

# Resolve the real application executable for non-macOS launches, once. An
# explicit TERMINA_BIN wins. PATH discovery must never resolve back to this
# launcher: the installed launcher is itself named `termina`, so a naive
# `command -v termina` self-executes forever.
resolve_linux_target() {
  if [ -n "${TERMINA_BIN:-}" ] && [ -f "$TERMINA_BIN" ] && [ -x "$TERMINA_BIN" ]; then
    echo "$TERMINA_BIN"
    return 0
  fi
  local found
  found="$(command -v termina 2>/dev/null | head -n 1 || true)"
  if [ -z "$found" ] || [ ! -f "$found" ] || [ ! -x "$found" ]; then
    return 1
  fi
  local self="$0"
  case "$self" in
    */*) ;;
    *) self="$(command -v "$self" 2>/dev/null | head -n 1 || true)" ;;
  esac
  if [ -n "$self" ] && [ "$(canonical_path "$found")" = "$(canonical_path "$self")" ]; then
    return 1
  fi
  echo "$found"
  return 0
}

resolve_app_path() {
  if [ -n "${TERMINA_APP_PATH:-}" ] && [ -d "$TERMINA_APP_PATH" ]; then
    echo "$TERMINA_APP_PATH"
    return 0
  fi
  if [ -d "/Applications/Termina.app" ]; then
    echo "/Applications/Termina.app"
    return 0
  fi
  if [ -d "$HOME/Applications/Termina.app" ]; then
    echo "$HOME/Applications/Termina.app"
    return 0
  fi
  local script_source="$0"
  if [ -L "$script_source" ]; then
    local link
    link="$(readlink "$script_source" 2>/dev/null || true)"
    if [ -n "$link" ]; then
      script_source="$link"
    fi
  fi
  local script_dir
  script_dir="$(CDPATH= cd -- "$(dirname -- "$script_source")" 2>/dev/null && pwd)"
  local candidate
  candidate="$(CDPATH= cd -- "$script_dir/../../.." 2>/dev/null && pwd)"
  if [ -d "$candidate" ] && [[ "$candidate" == *.app ]]; then
    echo "$candidate"
    return 0
  fi
  echo "/Applications/Termina.app"
}

print_help() {
  echo "Usage: termina [options] [path]"
  echo
  echo "Open a directory or file in Termina."
  echo
  echo "Arguments:"
  echo "  path           Path to directory or file to open (e.g. 'termina .')"
  echo
  echo "Options:"
  echo "  -h, --help     Show this help message"
  echo "  -v, --version  Show version"
}

print_version() {
  if [[ "$OSTYPE" == "darwin"* ]]; then
    local app_path
    app_path="$(resolve_app_path)"
    if [ -f "$app_path/Contents/Info.plist" ]; then
      local ver
      ver="$(defaults read "$app_path/Contents/Info.plist" CFBundleShortVersionString 2>/dev/null || true)"
      if [ -n "$ver" ]; then
        echo "Termina $ver"
        return 0
      fi
    fi
  fi
  local script_dir
  script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)"
  if [ -f "$script_dir/../package.json" ]; then
    local ver
    ver="$(grep '"version":' "$script_dir/../package.json" | head -n 1 | awk -F'"' '{print $4}' || true)"
    if [ -n "$ver" ]; then
      echo "Termina $ver"
      return 0
    fi
  fi
  echo "Termina"
}

case "${1:-}" in
  -h|--help)
    print_help
    exit 0
    ;;
  -v|--version)
    print_version
    exit 0
    ;;
esac

if [[ "$OSTYPE" == "darwin"* ]]; then
  APP_PATH="$(resolve_app_path)"

  if [ ! -d "$APP_PATH" ]; then
    echo "Error: Termina.app not found at $APP_PATH" >&2
    echo "Please install Termina in /Applications or set TERMINA_APP_PATH." >&2
    exit 1
  fi

  if [ "$#" -eq 0 ]; then
    # Launch or focus Termina without changing the active folder
    open -a "$APP_PATH"
    exit 0
  fi

  TARGET="$1"
  ABSOLUTE_PATH="$(resolve_target_path "$TARGET")"

  open -a "$APP_PATH" --args "$ABSOLUTE_PATH"
else
  LINUX_BIN="$(resolve_linux_target || true)"
  if [ -z "$LINUX_BIN" ]; then
    echo "Error: Termina executable not found (set TERMINA_BIN to the application executable)" >&2
    exit 1
  fi

  if [ "$#" -eq 0 ]; then
    exec "$LINUX_BIN"
  fi

  TARGET="$1"
  ABSOLUTE_PATH="$(resolve_target_path "$TARGET")"

  exec "$LINUX_BIN" "$ABSOLUTE_PATH"
fi
